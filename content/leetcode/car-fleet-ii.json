    {"input":[[[1,1],[2,1],[3,1]]],"expected":[-1,-1,-1]},
    {"input":[[[1,10],[2,1],[3,9],[20,1]]],"expected":[0.1111111111111111,-1,2.125,-1]},
    {"input":[[[3,4],[5,4],[6,3],[9,1]]],"expected":[2,1,1.5,-1]},
