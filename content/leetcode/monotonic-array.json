  "function": {
    "python": "isMonotonic",
    "java": "isMonotonic"
  },
  "params": [
    {
      "name": "nums",
      "type": "int[]"
    }
  ],
  "returns": "boolean",
  "tests": [
    {"input":[[1,2,2,3]],"expected":true,"sample":true},
    {"input":[[1,3,2]],"expected":false,"sample":true},
    {"input":[[1]],"expected":true},
    {"input":[[1,1]],"expected":true},
    {"input":[[2,1]],"expected":true},
    {"input":[[1,2]],"expected":true},
    {"input":[[3,2,2,1]],"expected":true},
    {"input":[[0,0,0]],"expected":true},
    {"input":[[-3,-2,-1]],"expected":true},
    {"input":[[2,1,2]],"expected":false}
