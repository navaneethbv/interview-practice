    }
  ],
  "returns": "int",
  "tests": [
    {"input":[[2,2,3,2]],"expected":3,"sample":true},
    {"input":[[0,1,0,1,0,1,99]],"expected":99,"sample":true},
    {"input":[[0]],"expected":0},
    {"input":[[-1]],"expected":-1},
