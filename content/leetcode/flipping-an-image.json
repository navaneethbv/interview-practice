{
  "id": "flipping-an-image",
  "style": "leetcode",
  "function": {
    "python": "flipAndInvertImage",
    "java": "flipAndInvertImage"
  },
  "params": [
    {
      "name": "image",
      "type": "int[][]"
    }
  ],
  "returns": "int[][]",
  "tests": [
    {"input":[[[1,0],[0,0]]],"expected":[[1,0],[1,1]],"sample":true},
    {"input":[[[0]]],"expected":[[1]],"sample":true},
    {"input":[[[1]]],"expected":[[0]]},
    {"input":[[[0,0],[0,0]]],"expected":[[1,1],[1,1]]},
    {"input":[[[1,1],[1,1]]],"expected":[[0,0],[0,0]]},
    {"input":[[[1,1],[0,1]]],"expected":[[0,0],[0,1]]},
    {"input":[[[1,0,0],[0,1,0],[1,1,1]]],"expected":[[1,1,0],[1,0,1],[0,0,0]]},
    {"input":[[[1,1,0],[1,0,1],[0,0,0]]],"expected":[[1,0,0],[0,1,0],[1,1,1]]},
    {"input":[[[0,1],[1,0]]],"expected":[[0,1],[1,0]]},
    {"input":[[[1,0,1],[0,0,1],[1,1,0]]],"expected":[[0,1,0],[0,1,1],[1,0,0]]}
  ]
}
