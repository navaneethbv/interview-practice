{
  "id": "find-largest-value-in-each-tree-row",
  "style": "leetcode",
  "function": {
    "python": "largestValues",
    "java": "largestValues"
  },
  "params": [
    {
      "name": "root",
      "type": "TreeNode"
    }
  ],
  "returns": "List<int>",
  "tests": [
    {"input":[[2,5,1,3,4]],"expected":[2,5,4],"sample":true},
    {"input":[[]],"expected":[],"sample":true},
    {"input":[[1]],"expected":[1]},
    {"input":[[-1,-2,-3]],"expected":[-1,-2]},
    {"input":[[0,0,0]],"expected":[0,0]},
    {"input":[[1,null,2,null,3]],"expected":[1,2,3]},
    {"input":[[3,2,null,1]],"expected":[3,2,1]},
    {"input":[[-2147483648]],"expected":[-2147483648]},
    {"input":[[1,3,2,5,3,null,9]],"expected":[1,3,9]},
    {"input":[[1,2,3,4,5,6,7]],"expected":[1,3,7]}
  ]
}
