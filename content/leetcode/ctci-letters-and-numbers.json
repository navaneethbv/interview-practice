{
  "id": "ctci-letters-and-numbers",
  "style": "leetcode",
  "function": {
    "python": "findLongestSubarray",
    "java": "findLongestSubarray"
  },
  "params": [
    {
      "name": "array",
      "type": "string[]"
    }
  ],
  "returns": "string[]",
  "tests": [
    {"input":[["a","1","b","c","2","3","d"]],"sample":true,"expected":["a","1","b","c","2","3"]},
    {"input":[["a","b"]],"sample":true,"expected":[]},
    {"input":[[]],"expected":[]},
    {"input":[["1"]],"expected":[]},
    {"input":[["a","1"]],"expected":["a","1"]},
    {"input":[["1","2","a","b"]],"expected":["1","2","a","b"]},
    {"input":[["a","1","b","2","3"]],"expected":["a","1","b","2"]},
    {"input":[["x","y","z","1","2"]],"expected":["y","z","1","2"]},
    {"input":[["a","a","1","1","1","b","b","b","2"]],"expected":["a","1","1","1","b","b","b","2"]},
    {"input":[["1","a","a","1","b","2"]],"expected":["1","a","a","1","b","2"]}
  ]
}
