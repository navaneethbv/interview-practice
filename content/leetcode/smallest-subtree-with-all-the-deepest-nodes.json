{
  "id": "smallest-subtree-with-all-the-deepest-nodes",
  "style": "leetcode",
  "function": {
    "python": "subtreeWithAllDeepest",
    "java": "subtreeWithAllDeepest"
  },
  "params": [
    {
      "name": "root",
      "type": "TreeNode"
    }
  ],
  "returns": "TreeNode",
  "tests": [
    {"input":[[3,5,1,6,2,0,8,null,null,7,4]],"expected":[2,7,4],"sample":true},
    {"input":[[1]],"expected":[1],"sample":true},
    {"input":[[1,2]],"expected":[2]},
    {"input":[[1,null,2]],"expected":[2]},
    {"input":[[1,2,3]],"expected":[1,2,3]},
    {"input":[[1,2,3,4]],"expected":[4]},
    {"input":[[1,2,3,4,5]],"expected":[2,4,5]},
    {"input":[[1,2,3,4,null,null,5]],"expected":[1,2,3,4,null,null,5]},
    {"input":[[0,1,null,2,null,3]],"expected":[3]},
    {"input":[[1,2,3,null,4,null,5,6]],"expected":[6]}
