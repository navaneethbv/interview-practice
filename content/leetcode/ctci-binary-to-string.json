  "function": {
    "python": "printBinary",
    "java": "printBinary"
  },
  "params": [
    {
      "name": "num",
      "type": "double"
    }
  ],
  "returns": "string",
  "tests": [
    {"input":[0.625],"sample":true,"expected":"0.101"},
