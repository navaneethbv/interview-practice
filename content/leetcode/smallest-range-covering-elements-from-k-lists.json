{
  "id": "smallest-range-covering-elements-from-k-lists",
  "style": "leetcode",
  "function": {
    "python": "smallestRange",
    "java": "smallestRange"
  },
  "params": [
    {
      "name": "nums",
      "type": "List<List<int>>"
    }
  ],
  "returns": "int[]",
  "tests": [
    {"input":[[[4,10,15,24,26],[0,9,12,20],[5,18,22,30]]],"expected":[20,24],"sample":true},
    {"input":[[[1],[3],[2]]],"expected":[1,3],"sample":true},
    {"input":[[[1]]],"expected":[1,1]},
    {"input":[[[1,2,3]]],"expected":[1,1]},
    {"input":[[[1,2],[1,3]]],"expected":[1,1]},
    {"input":[[[-5,-2],[-3,0]]],"expected":[-3,-2]},
    {"input":[[[1,10],[2,9]]],"expected":[1,2]},
    {"input":[[[0,0],[0]]],"expected":[0,0]},
    {"input":[[[-100000],[100000]]],"expected":[-100000,100000]},
    {"input":[[[1,4,7],[2,5,8],[3,6,9]]],"expected":[1,3]}
  ]
}
