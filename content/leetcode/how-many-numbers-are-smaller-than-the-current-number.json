{
  "id": "how-many-numbers-are-smaller-than-the-current-number",
  "style": "leetcode",
  "function": {
    "python": "smallerNumbersThanCurrent",
    "java": "smallerNumbersThanCurrent"
  },
  "params": [
    {
      "name": "nums",
      "type": "int[]"
    }
  ],
  "returns": "int[]",
  "tests": [
    {
      "input": [
        [
          8,
          1,
          2,
          2,
          3
        ]
      ],
      "expected": [
        4,
        0,
        1,
        1,
        3
      ],
      "sample": true
    },
    {
      "input": [
        [
          5,
          5,
          5
        ]
      ],
      "expected": [
        0,
        0,
        0
      ],
      "sample": true
    },
    {
      "input": [
        [
          1,
          2
        ]
      ],
      "expected": [
        0,
        1
      ]
    },
    {
      "input": [
        [
          2,
          1
        ]
      ],
      "expected": [
        1,
        0
      ]
    },
    {
      "input": [
        [
          0,
          100
        ]
      ],
      "expected": [
        0,
        1
      ]
    },
    {
      "input": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": [
        0,
        1,
        2,
        3
      ]
    },
    {
      "input": [
        [
          4,
          3,
          2,
          1
        ]
      ],
      "expected": [
        3,
        2,
        1,
        0
      ]
    },
    {
      "input": [
        [
          0,
          0,
          1
        ]
      ],
      "expected": [
        0,
        0,
        2
      ]
    },
    {
      "input": [
        [
          6,
          5,
          4,
          8
        ]
      ],
      "expected": [
        2,
        1,
        0,
        3
      ]
    },
    {
      "input": [
        [
          100,
          1,
          100,
          0
        ]
      ],
      "expected": [
        2,
        1,
        2,
        0
      ]
    }
  ]
}
