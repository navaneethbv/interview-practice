{
  "id": "3sum",
  "style": "leetcode",
  "function": {
    "python": "threeSum",
    "java": "threeSum"
  },
  "params": [
    {
      "name": "nums",
      "type": "int[]"
    }
  ],
  "returns": "List<List<int>>",
  "compare": "unorderedDeep",
  "tests": [
    {"input":[[-2,0,2,2,-1,-1]],"expected":[[-2,0,2],[-1,-1,2]],"sample":true},
    {"input":[[0,0,0,0]],"expected":[[0,0,0]],"sample":true},
    {"input":[[1,2,3]],"expected":[]},
    {"input":[[-1,0,1]],"expected":[[-1,0,1]]},
    {"input":[[-1,-1,2]],"expected":[[-1,-1,2]]},
    {"input":[[0,1,1]],"expected":[]},
    {"input":[[-4,-2,-2,0,2,4]],"expected":[[-4,0,4],[-2,-2,4],[-2,0,2]]},
    {"input":[[-100000,0,100000]],"expected":[[-100000,0,100000]]},
    {"input":[[0,0,1,-1]],"expected":[[-1,0,1]]},
    {"input":[[-2,-1,0,1,2,3]],"expected":[[-2,-1,3],[-2,0,2],[-1,0,1]]},
    {"input":[[3,-3,3,-3,0,0]],"expected":[[-3,0,3]]}
  ]
}
