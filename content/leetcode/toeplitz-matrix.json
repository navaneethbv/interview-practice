{
  "id": "toeplitz-matrix",
  "style": "leetcode",
  "function": {
    "python": "isToeplitzMatrix",
    "java": "isToeplitzMatrix"
  },
  "params": [
    {
      "name": "matrix",
      "type": "int[][]"
    }
  ],
  "returns": "boolean",
  "tests": [
    {"input":[[[1,2,3],[4,1,2],[5,4,1]]],"expected":true,"sample":true},
    {"input":[[[1,2],[2,2]]],"expected":false,"sample":true},
    {"input":[[[1]]],"expected":true},
    {"input":[[[1,2,3]]],"expected":true},
    {"input":[[[1],[2],[3]]],"expected":true},
    {"input":[[[0,0],[0,0]]],"expected":true},
    {"input":[[[1,2],[3,1]]],"expected":true},
    {"input":[[[1,2,3],[4,1,9]]],"expected":false},
    {"input":[[[1,2],[3,1],[4,3]]],"expected":true},
    {"input":[[[99,0],[1,99]]],"expected":true}
  ]
