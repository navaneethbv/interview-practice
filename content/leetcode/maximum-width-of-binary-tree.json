    {"input":[[1,2,3]],"expected":2},
    {"input":[[1,2,3,4,null,null,5]],"expected":4},
    {"input":[[1,2,3,4,5,6,7]],"expected":4},
    {"input":[[1,2,3,4,null,null,5,6,null,null,7]],"expected":8},
    {"input":[[1,null,2,null,3,null,4]],"expected":1}
