{
  "id": "find-all-numbers-disappeared-in-an-array",
  "style": "leetcode",
  "function": {
    "python": "findDisappearedNumbers",
    "java": "findDisappearedNumbers"
  },
  "params": [
    {
      "name": "nums",
      "type": "int[]"
    }
  ],
  "returns": "List<int>",
  "compare": "unordered",
  "tests": [
    {"input":[[4,3,2,7,8,2,3,1]],"expected":[5,6],"sample":true},
    {"input":[[1,1]],"expected":[2],"sample":true},
    {"input":[[1]],"expected":[]},
    {"input":[[1,2]],"expected":[]},
    {"input":[[2,2]],"expected":[1]},
    {"input":[[3,3,3]],"expected":[1,2]},
    {"input":[[1,2,3,4]],"expected":[]},
    {"input":[[4,4,4,4]],"expected":[1,2,3]},
    {"input":[[1,1,2,2,3]],"expected":[4,5]},
    {"input":[[5,4,3,2,1]],"expected":[]}
  ]
