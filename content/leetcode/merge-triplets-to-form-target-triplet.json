{
  "id": "merge-triplets-to-form-target-triplet",
  "style": "leetcode",
  "function": {
    "python": "mergeTriplets",
    "java": "mergeTriplets"
  },
  "params": [
    {
      "name": "triplets",
      "type": "int[][]"
    },
    {
      "name": "target",
      "type": "int[]"
    }
  ],
  "returns": "boolean",
  "tests": [
    {"input":[[[2,5,3],[1,8,4],[1,7,5]],[2,7,5]],"expected":true,"sample":true},
    {"input":[[[3,1,1],[1,3,1]],[2,2,1]],"expected":false,"sample":true},
    {"input":[[[1,1,1]],[1,1,1]],"expected":true},
    {"input":[[[1,1,1]],[2,2,2]],"expected":false},
    {"input":[[[2,1,1],[1,2,1],[1,1,2]],[2,2,2]],"expected":true},
    {"input":[[[2,1,1],[1,2,1]],[2,2,2]],"expected":false},
    {"input":[[[5,5,5],[2,2,2]],[2,2,2]],"expected":true},
    {"input":[[[1,2,3],[3,2,1]],[3,2,3]],"expected":true},
    {"input":[[[1,2,3],[3,3,3]],[3,2,3]],"expected":false},
    {"input":[[[1000,1,1],[1,1000,1],[1,1,1000]],[1000,1000,1000]],"expected":true}
  ]
}
