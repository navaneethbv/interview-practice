{
  "id": "rearrange-array-elements-by-sign",
  "style": "leetcode",
  "function": {
    "python": "rearrangeArray",
    "java": "rearrangeArray"
  },
  "params": [
    {
      "name": "nums",
      "type": "int[]"
    }
  ],
  "returns": "int[]",
  "tests": [
    {
      "input": [
        [
          3,
          1,
          -2,
          -5,
          2,
          -4
        ]
      ],
      "expected": [
        3,
        -2,
        1,
        -5,
        2,
        -4
      ],
      "sample": true
    },
    {
      "input": [
        [
          -1,
          1
        ]
      ],
      "expected": [
        1,
        -1
      ],
      "sample": true
    },
    {
      "input": [
        [
          1,
          -1
        ]
      ],
      "expected": [
        1,
        -1
      ]
    },
    {
      "input": [
        [
          -1,
          -2,
          1,
          2
        ]
      ],
      "expected": [
        1,
        -1,
        2,
        -2
      ]
    },
    {
      "input": [
        [
          1,
          2,
          -1,
          -2
        ]
      ],
      "expected": [
        1,
        -1,
        2,
        -2
      ]
    },
    {
      "input": [
        [
          -1,
          1,
          -2,
          2
        ]
      ],
      "expected": [
        1,
        -1,
        2,
        -2
      ]
    },
    {
      "input": [
        [
          1,
          -1,
          2,
          -2
        ]
      ],
      "expected": [
        1,
        -1,
        2,
        -2
      ]
    },
    {
      "input": [
        [
          2,
          2,
          -2,
          -2
        ]
      ],
      "expected": [
        2,
        -2,
        2,
        -2
      ]
    },
    {
      "input": [
        [
          100000,
          -100000
        ]
      ],
      "expected": [
        100000,
        -100000
      ]
    },
    {
      "input": [
        [
          1,
          2,
          3,
          -3,
          -2,
          -1
        ]
      ],
      "expected": [
        1,
        -3,
        2,
        -2,
        3,
        -1
      ]
    }
  ]
}
