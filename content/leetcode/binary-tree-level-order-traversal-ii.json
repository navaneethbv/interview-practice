{
  "id": "binary-tree-level-order-traversal-ii",
  "style": "leetcode",
  "function": {
    "python": "levelOrderBottom",
    "java": "levelOrderBottom"
  },
  "params": [
    {
      "name": "root",
      "type": "TreeNode"
    }
  ],
  "returns": "List<List<int>>",
  "tests": [
    {"input":[[3,9,20,null,null,15,7]],"expected":[[15,7],[9,20],[3]],"sample":true},
    {"input":[[]],"expected":[],"sample":true},
    {"input":[[1]],"expected":[[1]]},
    {"input":[[1,2,3]],"expected":[[2,3],[1]]},
    {"input":[[1,2]],"expected":[[2],[1]]},
    {"input":[[1,null,2]],"expected":[[2],[1]]},
    {"input":[[1,2,3,4,5,6,7]],"expected":[[4,5,6,7],[2,3],[1]]},
    {"input":[[-1,-2,-3]],"expected":[[-2,-3],[-1]]},
    {"input":[[1,1,1]],"expected":[[1,1],[1]]},
    {"input":[[1,2,null,3,null,4]],"expected":[[4],[3],[2],[1]]}
  ]
}
