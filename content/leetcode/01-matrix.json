{
  "id": "01-matrix",
  "style": "leetcode",
  "function": {
    "python": "updateMatrix",
    "java": "updateMatrix"
  },
  "params": [
    {
      "name": "mat",
      "type": "int[][]"
    }
  ],
  "returns": "int[][]",
  "tests": [
    {"input":[[[0,1],[1,1]]],"expected":[[0,1],[1,2]],"sample":true},
    {"input":[[[0,0,0]]],"expected":[[0,0,0]],"sample":true},
    {"input":[[[0]]],"expected":[[0]]},
    {"input":[[[0,1,1,1]]],"expected":[[0,1,2,3]]},
    {"input":[[[1,1,0]]],"expected":[[2,1,0]]},
