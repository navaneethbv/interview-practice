  "function": {
    "python": "magicIndex",
    "java": "magicIndex"
  },
  "params": [
    {
      "name": "A",
      "type": "int[]"
    }
  ],
  "returns": "int",
  "tests": [
    {"input":[[-40,-20,-1,1,2,3,5,7,9,12,13]],"sample":true,"expected":7},
    {"input":[[-10,-5,2,2,2,3,4,7,9,12,13]],"sample":true,"expected":2},
    {"input":[[]],"expected":-1},
    {"input":[[0]],"expected":0},
    {"input":[[1]],"expected":-1},
    {"input":[[-1,0,1,2]],"expected":-1},
    {"input":[[0,1,2,3]],"expected":0},
    {"input":[[5,5,5,5,5,5,6]],"expected":5},
    {"input":[[-1,1,1,1,4]],"expected":1},
    {"input":[[1,1,1,3,3,5]],"expected":1},
    {"input":[[-1000000000,1000000000]],"expected":-1}
