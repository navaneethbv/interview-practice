{
  "id": "vertical-order-traversal-of-a-binary-tree",
  "style": "leetcode",
  "function": {
    "python": "verticalTraversal",
    "java": "verticalTraversal"
  },
  "params": [
    {
      "name": "root",
      "type": "TreeNode"
    }
  ],
  "returns": "List<List<int>>",
  "tests": [
    {"input":[[3,9,20,null,null,15,7]],"expected":[[9],[3,15],[20],[7]],"sample":true},
    {"input":[[1,2,3,4,6,5,7]],"expected":[[4],[2],[1,5,6],[3],[7]],"sample":true},
    {"input":[[1]],"expected":[[1]]},
    {"input":[[1,2]],"expected":[[2],[1]]},
    {"input":[[1,null,2]],"expected":[[1],[2]]},
    {"input":[[1,2,3]],"expected":[[2],[1],[3]]},
    {"input":[[0,0,0]],"expected":[[0],[0],[0]]},
    {"input":[[1,2,3,4,5,6,7]],"expected":[[4],[2],[1,5,6],[3],[7]]},
    {"input":[[1,null,2,3]],"expected":[[1,3],[2]]},
    {"input":[[5,4,3,null,2,1]],"expected":[[4],[5,1,2],[3]]}
  ]
}
