{
  "id": "summary-ranges",
  "style": "leetcode",
  "function": {
    "python": "summaryRanges",
    "java": "summaryRanges"
  },
  "params": [
    {
      "name": "nums",
      "type": "int[]"
    }
  ],
  "returns": "List<string>",
  "tests": [
    {"input":[[0,1,2,4,5,7]],"expected":["0->2","4->5","7"],"sample":true},
    {"input":[[1]],"expected":["1"],"sample":true},
    {"input":[[]],"expected":[]},
    {"input":[[0,2]],"expected":["0","2"]},
    {"input":[[1,2]],"expected":["1->2"]},
    {"input":[[-3,-2,-1,1]],"expected":["-3->-1","1"]},
    {"input":[[-2147483648,2147483647]],"expected":["-2147483648","2147483647"]},
    {"input":[[-1,0,1]],"expected":["-1->1"]},
    {"input":[[2147483646,2147483647]],"expected":["2147483646->2147483647"]},
    {"input":[[1,3,5,7]],"expected":["1","3","5","7"]}
  ]
}
