  "function": {
    "python": "uniqueOccurrences",
    "java": "uniqueOccurrences"
  },
  "params": [
    {
      "name": "arr",
      "type": "int[]"
    }
  ],
  "returns": "boolean",
  "tests": [
    {"input":[[1,2,2,1,1,3]],"expected":true,"sample":true},
    {"input":[[1,2]],"expected":false,"sample":true},
    {"input":[[1]],"expected":true},
    {"input":[[1,1]],"expected":true},
    {"input":[[1,1,2]],"expected":true},
