{
  "id": "binary-tree-zigzag-level-order-traversal",
  "style": "leetcode",
  "function": {
    "python": "zigzagLevelOrder",
    "java": "zigzagLevelOrder"
  },
  "params": [
    {
      "name": "root",
      "type": "TreeNode"
    }
  ],
  "returns": "List<List<int>>",
  "tests": [
    {"input":[[3,9,20,null,null,15,7]],"expected":[[3],[20,9],[15,7]],"sample":true},
    {"input":[[]],"expected":[],"sample":true},
    {"input":[[1]],"expected":[[1]]},
    {"input":[[1,2,3]],"expected":[[1],[3,2]]},
    {"input":[[1,2,null,3]],"expected":[[1],[2],[3]]},
    {"input":[[1,null,2,null,3]],"expected":[[1],[2],[3]]},
    {"input":[[1,2,3,4,5,6,7]],"expected":[[1],[3,2],[4,5,6,7]]},
    {"input":[[0,-1,1]],"expected":[[0],[1,-1]]},
    {"input":[[1,1,1]],"expected":[[1],[1,1]]},
    {"input":[[1,2,3,null,4,5]],"expected":[[1],[3,2],[4,5]]}
  ]
}
