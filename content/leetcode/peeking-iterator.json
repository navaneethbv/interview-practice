  "tests": [
    {"input":{"ctor":[[1,2,3]],"ops":["peek","peek","next","next","hasNext","next","hasNext"],"args":[[],[],[],[],[],[],[]]},"expected":[1,1,1,2,true,3,false],"sample":true},
