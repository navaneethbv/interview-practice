    "python": "pathSum",
    "java": "pathSum"
  },
  "params": [
    {
      "name": "root",
      "type": "TreeNode"
    },
    {
      "name": "targetSum",
      "type": "int"
    }
  ],
  "returns": "List<List<int>>",
  "compare": "unordered",
  "tests": [
    {"input":[[1,2,3],3],"expected":[[1,2]],"sample":true},
    {"input":[[1,2],1],"expected":[],"sample":true},
    {"input":[[],0],"expected":[]},
    {"input":[[1],1],"expected":[[1]]},
