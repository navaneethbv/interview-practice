    }
  ],
  "returns": "int[]",
  "tests": [
    {"input":[[-4,-1,0,3,10]],"expected":[0,1,9,16,100],"sample":true},
    {"input":[[-3,-2,-1]],"expected":[1,4,9],"sample":true},
    {"input":[[0]],"expected":[0]},
    {"input":[[1]],"expected":[1]},
    {"input":[[-1]],"expected":[1]},
    {"input":[[-2,2]],"expected":[4,4]},
