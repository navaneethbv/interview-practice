    {"input":[[[0,1,0],[1,1,1]]],"expected":[[0,1,0],[1,2,1]]},
    {"input":[[[1,1,1],[1,0,1],[1,1,1]]],"expected":[[2,1,2],[1,0,1],[2,1,2]]},
    {"input":[[[0,0],[0,0]]],"expected":[[0,0],[0,0]]},
    {"input":[[[1,1,1],[1,1,1],[1,1,0]]],"expected":[[4,3,2],[3,2,1],[2,1,0]]}
  ]
