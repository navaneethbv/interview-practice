    {"input":{"ctor":[["Hello"]],"ops":["getFrequency","getFrequency","getFrequency"],"args":[["hello"],["HELLO"],["hell"]]},"expected":[1,1,0]},
    {"input":{"ctor":[["to","be","or","not","to","be"]],"ops":["getFrequency","getFrequency","getFrequency","getFrequency"],"args":[["to"],["be"],["or"],["question"]]},"expected":[2,2,1,0]},
    {"input":{"ctor":[["xYz","XyZ","xyz","XYZ"]],"ops":["getFrequency"],"args":[["xyz"]]},"expected":[4]}
