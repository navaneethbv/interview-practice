{
  "id": "ctci-sub-sort",
  "style": "leetcode",
  "function": {
    "python": "findUnsortedSequence",
    "java": "findUnsortedSequence"
  },
  "params": [
    {
      "name": "array",
      "type": "int[]"
    }
  ],
  "returns": "int[]",
  "tests": [
    {"input":[[1,2,4,7,10,11,7,12,6,7,16,18,19]],"sample":true,"expected":[3,9]},
    {"input":[[1,2,2,3]],"sample":true,"expected":[-1,-1]},
    {"input":[[]],"expected":[-1,-1]},
    {"input":[[5]],"expected":[-1,-1]},
    {"input":[[2,1]],"expected":[0,1]},
    {"input":[[3,2,1]],"expected":[0,2]},
    {"input":[[1,3,2,4]],"expected":[1,2]},
    {"input":[[1,2,3,3,3,2]],"expected":[2,5]},
    {"input":[[2,2,1,1]],"expected":[0,3]},
    {"input":[[1,5,3,4,2,6]],"expected":[1,4]},
    {"input":[[0,0,0,-1]],"expected":[0,3]}
  ]
}
