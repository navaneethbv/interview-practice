{
  "id": "combination-sum-ii",
  "style": "leetcode",
  "function": {
    "python": "combinationSum2",
    "java": "combinationSum2"
  },
  "params": [
    {
      "name": "candidates",
      "type": "int[]"
    },
    {
      "name": "target",
      "type": "int"
    }
  ],
  "returns": "List<List<int>>",
  "compare": "unorderedDeep",
  "tests": [
    {"input":[[1,1,2,3],4],"expected":[[1,1,2],[1,3]],"sample":true},
    {"input":[[2,2,2],3],"expected":[],"sample":true},
    {"input":[[1],1],"expected":[[1]]},
    {"input":[[1],2],"expected":[]},
    {"input":[[1,1,1],2],"expected":[[1,1]]},
    {"input":[[2,5,2,1,2],5],"expected":[[1,2,2],[5]]},
    {"input":[[10,1,2,7,6,1,5],8],"expected":[[1,1,6],[1,2,5],[1,7],[2,6]]},
    {"input":[[3,4,5],2],"expected":[]},
    {"input":[[1,2,3,4,5],10],"expected":[[1,2,3,4],[1,4,5],[2,3,5]]},
    {"input":[[2,2,2,2,2,2,2,2,2,2],8],"expected":[[2,2,2,2]]},
    {"input":[[30,1,29],30],"expected":[[1,29],[30]]},
    {"input":[[1,1,2,2],3],"expected":[[1,2]]}
  ]
}
