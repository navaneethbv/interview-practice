    {"input":[[1,2,2],3],"expected":[[1,2],[1,2]]},
    {"input":[[0,0,0],0],"expected":[[0,0],[0,0]]},
    {"input":[[-2,null,-3],-5],"expected":[[-2,-3]]},
    {"input":[[5,4,8,11,null,13,4,7,2,null,null,5,1],22],"expected":[[5,8,4,5],[5,4,11,2]]},
    {"input":[[1,-2,-3,1,3,-2,null,-1],-1],"expected":[[1,-2,1,-1]]}
