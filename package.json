{
  "name": "interview-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ingest:grokking": "tsx scripts/ingest/grokking.ts",
    "tests:build": "node --import tsx scripts/judge/build-tests.ts",
    "sandbox:snapshot": "tsx --env-file-if-exists=.env.local scripts/sandbox/create-code-snapshot.ts",
    "ingest:system-design": "python3 scripts/ingest/system_design.py",
    "test": "node --import tsx --test src/lib/*.test.ts src/lib/judge/*.test.ts && python3 -B -m unittest discover -s scripts/ingest -p 'test_*.py' && python3 -B scripts/judge/test_practice_additions.py",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium",
    "worker:build": "esbuild scripts/judge/js-worker.mjs --bundle --platform=browser --format=iife --target=es2020 --minify --charset=ascii --outfile=public/js-worker.js",
    "prebuild": "npm run worker:build",
    "predev": "npm run worker:build",
    "pretest": "npm run worker:build"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@monaco-editor/react": "^4.7.0",
    "@vercel/sandbox": "^3.5.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
