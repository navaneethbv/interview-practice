{
  "id": "set-matrix-zeroes",
  "style": "leetcode",
  "function": {
    "python": "setZeroes",
    "java": "setZeroes"
  },
  "params": [
    {
      "name": "matrix",
      "type": "int[][]"
    }
  ],
  "returns": "void",
  "output": {
    "arg": 0
  },
  "tests": [
    {"input":[[[1,2,3],[4,0,6]]],"expected":[[1,0,3],[0,0,0]],"sample":true},
    {"input":[[[1,2],[3,4]]],"expected":[[1,2],[3,4]],"sample":true},
    {"input":[[[0]]],"expected":[[0]]},
    {"input":[[[7]]],"expected":[[7]]},
    {"input":[[[1,0,3]]],"expected":[[0,0,0]]},
    {"input":[[[1],[0],[3]]],"expected":[[0],[0],[0]]},
    {"input":[[[0,1],[2,3]]],"expected":[[0,0],[0,3]]},
    {"input":[[[1,2],[3,0]]],"expected":[[1,0],[0,0]]},
    {"input":[[[0,0],[0,0]]],"expected":[[0,0],[0,0]]},
    {"input":[[[1,0,3],[4,5,6],[7,8,0]]],"expected":[[0,0,0],[4,0,0],[0,0,0]]},
    {"input":[[[-2147483648,1],[0,2147483647]]],"expected":[[0,1],[0,0]]},
    {"input":[[[1,2,0],[4,5,6],[0,8,9]]],"expected":[[0,0,0],[0,5,0],[0,0,0]]}
  ]
}
