{
  "id": "bctci-nested-circles",
  "style": "leetcode",
  "function": {
    "python": "areNested",
    "java": "areNested"
  },
  "params": [
    {
      "name": "circles",
      "type": "int[][]"
    }
  ],
  "returns": "boolean",
  "tests": [
    {"input":[[[4,4,5],[8,4,2]]],"sample":true,"expected":false},
    {"input":[[[5,3,3],[5,3,2],[4,4,5]]],"sample":true,"expected":true},
    {"input":[[[5,3,3]]],"expected":true},
    {"input":[[[0,0,2],[0,0,2]]],"expected":false},
    {"input":[[[0,0,5],[3,0,2]]],"expected":false},
    {"input":[[[0,0,5],[2,0,2]]],"expected":true},
    {"input":[[[0,0,10],[0,0,1],[8,0,1]]],"expected":false},
    {"input":[[[1,1,1],[1,1,3],[1,1,2]]],"expected":true}
  ]
}
