  "tests": [
    {"input":["((a+b)*[c-d]-{e/f})",["()","[]","{}"]],"sample":true,"expected":true},
    {"input":["([)]",["()","[]","{}"]],"sample":true,"expected":false},
    {"input":["()[}",["()","[]","{}"]],"expected":false},
