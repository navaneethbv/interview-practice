{
  "id": "clone-graph",
  "style": "leetcode",
  "function": {
    "python": "cloneGraph",
    "java": "cloneGraph"
  },
  "params": [
    {
      "name": "node",
      "type": "GraphNode"
    }
  ],
  "returns": "GraphNode",
  "tests": [
    {"input":[[[2,3],[1,3],[1,2]]],"expected":[[2,3],[1,3],[1,2]],"sample":true},
    {"input":[[]],"expected":[],"sample":true},
    {"input":[[[]]],"expected":[[]]},
    {"input":[[[2],[1]]],"expected":[[2],[1]]},
    {"input":[[[2],[1,3],[2]]],"expected":[[2],[1,3],[2]]},
    {"input":[[[2,4],[1,3],[2,4],[1,3]]],"expected":[[2,4],[1,3],[2,4],[1,3]]},
    {"input":[[[2,3,4],[1],[1],[1]]],"expected":[[2,3,4],[1],[1],[1]]},
    {"input":[[[2,3,4],[1,3,4],[1,2,4],[1,2,3]]],"expected":[[2,3,4],[1,3,4],[1,2,4],[1,2,3]]},
    {"input":[[[2],[1,3],[2,4],[3,5],[4]]],"expected":[[2],[1,3],[2,4],[3,5],[4]]},
    {"input":[[[3,2],[3,1],[2,1,4],[3]]],"expected":[[2,3],[1,3],[1,2,4],[3]]}
  ]
