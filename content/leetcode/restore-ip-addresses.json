{
  "id": "restore-ip-addresses",
  "style": "leetcode",
  "function": {
    "python": "restoreIpAddresses",
    "java": "restoreIpAddresses"
  },
  "params": [
    {
      "name": "s",
      "type": "string"
    }
  ],
  "returns": "List<string>",
  "compare": "unordered",
  "tests": [
    {"input":["25525511135"],"expected":["255.255.11.135","255.255.111.35"],"sample":true},
    {"input":["0000"],"expected":["0.0.0.0"],"sample":true},
    {"input":["1"],"expected":[]},
    {"input":["1111"],"expected":["1.1.1.1"]},
    {"input":["010010"],"expected":["0.10.0.10","0.100.1.0"]},
    {"input":["101023"],"expected":["1.0.10.23","1.0.102.3","10.1.0.23","10.10.2.3","101.0.2.3"]},
    {"input":["999999999999"],"expected":[]},
    {"input":["256256256256"],"expected":[]},
    {"input":["00000"],"expected":[]},
    {"input":["123123123123"],"expected":["123.123.123.123"]},
    {"input":["1111111111111"],"expected":[]}
  ]
}
