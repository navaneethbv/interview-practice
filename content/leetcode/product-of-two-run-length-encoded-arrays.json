{
  "id": "product-of-two-run-length-encoded-arrays",
  "style": "leetcode",
  "function": {
    "python": "findRLEArray",
    "java": "findRLEArray"
  },
  "params": [
    {
      "name": "encoded1",
      "type": "int[][]"
    },
    {
      "name": "encoded2",
      "type": "int[][]"
    }
  ],
  "returns": "List<List<int>>",
  "tests": [
    {"input":[[[1,3],[2,3]],[[6,3],[3,3]]],"expected":[[6,6]],"sample":true},
    {"input":[[[2,2],[3,1]],[[4,1],[5,2]]],"expected":[[8,1],[10,1],[15,1]],"sample":true},
    {"input":[[[1,1]],[[2,1]]],"expected":[[2,1]]},
    {"input":[[[2,3]],[[3,3]]],"expected":[[6,3]]},
    {"input":[[[1,2],[2,2]],[[3,4]]],"expected":[[3,2],[6,2]]},
    {"input":[[[1,4]],[[2,1],[3,3]]],"expected":[[2,1],[3,3]]},
    {"input":[[[2,1],[3,1]],[[3,1],[2,1]]],"expected":[[6,2]]},
    {"input":[[[10000,10000]],[[10000,10000]]],"expected":[[100000000,10000]]},
    {"input":[[[1,1],[2,1],[1,1]],[[2,3]]],"expected":[[2,1],[4,1],[2,1]]},
    {"input":[[[2,2],[4,2]],[[3,1],[3,3]]],"expected":[[6,2],[12,2]]}
  ]
}
