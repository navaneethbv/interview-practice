  "function": {
    "python": "oddEvenList",
    "java": "oddEvenList"
  },
  "params": [
    {
      "name": "head",
      "type": "ListNode"
    }
  ],
  "returns": "ListNode",
  "tests": [
    {"input":[[1,2,3,4,5]],"expected":[1,3,5,2,4],"sample":true},
    {"input":[[2,1,3,5,6,4,7]],"expected":[2,3,6,7,1,5,4],"sample":true},
    {"input":[[]],"expected":null},
    {"input":[[1]],"expected":[1]},
    {"input":[[1,2]],"expected":[1,2]},
    {"input":[[1,2,3]],"expected":[1,3,2]},
    {"input":[[1,2,3,4]],"expected":[1,3,2,4]},
