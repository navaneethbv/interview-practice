{
  "id": "product-of-array-except-self",
  "style": "leetcode",
  "function": {
    "python": "productExceptSelf",
    "java": "productExceptSelf"
  },
  "params": [
    {
      "name": "nums",
      "type": "int[]"
    }
  ],
  "returns": "int[]",
  "tests": [
    {"input":[[2,3,4]],"expected":[12,8,6],"sample":true},
    {"input":[[0,5,2]],"expected":[10,0,0],"sample":true},
    {"input":[[0,0]],"expected":[0,0]},
    {"input":[[1,2]],"expected":[2,1]},
    {"input":[[-1,-2,-3]],"expected":[6,3,2]},
    {"input":[[1,1,1,1]],"expected":[1,1,1,1]},
    {"input":[[0,-2,3]],"expected":[-6,0,0]},
    {"input":[[2,0,3,0]],"expected":[0,0,0,0]},
    {"input":[[-1,1,-1,1]],"expected":[-1,1,-1,1]},
    {"input":[[30,30,30,30]],"expected":[27000,27000,27000,27000]},
    {"input":[[-2,3,0,4]],"expected":[0,0,-24,0]}
