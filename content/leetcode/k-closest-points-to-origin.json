{
  "id": "k-closest-points-to-origin",
  "style": "leetcode",
  "function": {
    "python": "kClosest",
    "java": "kClosest"
  },
  "params": [
    {
      "name": "points",
      "type": "int[][]"
    },
    {
      "name": "k",
      "type": "int"
    }
  ],
  "returns": "int[][]",
  "compare": "unordered",
  "tests": [
    {"input":[[[1,2],[5,5],[-1,0]],2],"expected":[[-1,0],[1,2]],"sample":true},
    {"input":[[[3,4]],1],"expected":[[3,4]],"sample":true},
    {"input":[[[0,0],[1,1]],1],"expected":[[0,0]]},
    {"input":[[[-2,-3],[3,4]],1],"expected":[[-2,-3]]},
    {"input":[[[1,2],[2,1],[10,10]],2],"expected":[[1,2],[2,1]]},
    {"input":[[[0,1],[0,-1]],2],"expected":[[0,1],[0,-1]]},
    {"input":[[[0,0],[0,0],[1,1]],2],"expected":[[0,0],[0,0]]},
    {"input":[[[10000,10000],[-10000,0]],1],"expected":[[-10000,0]]},
    {"input":[[[3,0],[2,0],[1,0]],2],"expected":[[1,0],[2,0]]},
    {"input":[[[-3,4],[1,1],[0,0],[10,0]],3],"expected":[[0,0],[1,1],[-3,4]]}
  ]
}
