{
  "id": "ctci-peaks-and-valleys",
  "style": "leetcode",
  "function": {
    "python": "sortValleyPeak",
    "java": "sortValleyPeak"
  },
  "params": [
    {
      "name": "array",
      "type": "int[]"
    }
  ],
  "returns": "int[]",
  "compare": {
    "validator": "peaksValleys"
  },
  "tests": [
    {"input":[[5,3,1,2,3]],"sample":true,"expected":[5,1,3,2,3]},
    {"input":[[1,2]],"sample":true,"expected":[1,2]},
    {"input":[[]],"expected":[]},
    {"input":[[4]],"expected":[4]},
    {"input":[[1,2,3,4,5,6]],"expected":[1,3,2,5,4,6]},
    {"input":[[6,5,4,3,2,1]],"expected":[5,6,3,4,1,2]},
    {"input":[[2,2,2,2]],"expected":[2,2,2,2]},
    {"input":[[9,1,0,4,8,7]],"expected":[1,9,0,8,4,7]},
    {"input":[[-1,-1,0,0,1,1]],"expected":[-1,0,-1,1,0,1]},
    {"input":[[1000000000,-1000000000,0]],"expected":[-1000000000,1000000000,0]}
