{
  "id": "binary-tree-level-order-traversal",
  "style": "leetcode",
  "function": {
    "python": "levelOrder",
    "java": "levelOrder"
  },
  "params": [
    {
      "name": "root",
      "type": "TreeNode"
    }
  ],
  "returns": "List<List<int>>",
  "tests": [
    {"input":[[6,2,8,null,4]],"expected":[[6],[2,8],[4]],"sample":true},
    {"input":[[]],"expected":[],"sample":true},
    {"input":[[]],"expected":[]},
    {"input":[[1]],"expected":[[1]]},
    {"input":[[1,2]],"expected":[[1],[2]]},
    {"input":[[1,null,2]],"expected":[[1],[2]]},
    {"input":[[1,2,3]],"expected":[[1],[2,3]]},
    {"input":[[1,2,null,3]],"expected":[[1],[2],[3]]},
    {"input":[[1,null,2,null,3]],"expected":[[1],[2],[3]]},
    {"input":[[-1,-2,-3]],"expected":[[-1],[-2,-3]]},
    {"input":[[1,2,3,4,null,null,5]],"expected":[[1],[2,3],[4,5]]}
  ]
}
