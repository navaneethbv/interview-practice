{
  "id": "find-all-lonely-numbers-in-the-array",
  "style": "leetcode",
  "function": {
    "python": "findLonely",
    "java": "findLonely"
  },
  "params": [
    {
      "name": "nums",
      "type": "int[]"
    }
  ],
  "returns": "List<int>",
  "compare": "unordered",
  "tests": [
    {"input":[[2,4,4,7,8,10]],"expected":[2,10],"sample":true},
    {"input":[[1,2,3]],"expected":[],"sample":true},
    {"input":[[0]],"expected":[0]},
    {"input":[[1,1]],"expected":[]},
    {"input":[[0,2,4]],"expected":[0,2,4]},
    {"input":[[0,1]],"expected":[]},
    {"input":[[1000000]],"expected":[1000000]},
    {"input":[[1,3,5,3]],"expected":[1,5]},
    {"input":[[10,6,5,8]],"expected":[10,8]},
    {"input":[[1,1,2,4]],"expected":[4]}
  ]
}
