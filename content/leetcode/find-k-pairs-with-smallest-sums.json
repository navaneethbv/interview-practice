{
  "id": "find-k-pairs-with-smallest-sums",
  "style": "leetcode",
  "function": {
    "python": "kSmallestPairs",
    "java": "kSmallestPairs"
  },
  "params": [
    {
      "name": "nums1",
      "type": "int[]"
    },
    {
      "name": "nums2",
      "type": "int[]"
    },
    {
      "name": "k",
      "type": "int"
    }
  ],
  "returns": "List<List<int>>",
  "compare": {
    "validator": "smallestPairs"
  },
  "tests": [
    {"input":[[1,7,11],[2,4,6],3],"expected":[[1,2],[1,4],[1,6]],"sample":true},
    {"input":[[1,1],[2],3],"expected":[[1,2],[1,2]],"sample":true},
    {"input":[[1],[2],1],"expected":[[1,2]]},
    {"input":[[1,2],[3,4],2],"expected":[[1,3],[1,4]]},
    {"input":[[0,0],[0,0],3],"expected":[[0,0],[0,0],[0,0]]},
    {"input":[[-2,-1],[1,2],3],"expected":[[-2,1],[-2,2],[-1,1]]},
    {"input":[[1,2],[1,2],4],"expected":[[1,1],[1,2],[2,1],[2,2]]},
    {"input":[[1,3],[2,4],2],"expected":[[1,2],[1,4]]},
    {"input":[[1000000000],[1000000000],1],"expected":[[1000000000,1000000000]]},
    {"input":[[-1000000000,0],[0,1000000000],3],"expected":[[-1000000000,0],[-1000000000,1000000000],[0,0]]}
