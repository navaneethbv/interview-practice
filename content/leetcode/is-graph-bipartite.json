{
  "id": "is-graph-bipartite",
  "style": "leetcode",
  "function": {
    "python": "isBipartite",
    "java": "isBipartite"
  },
  "params": [
    {
      "name": "graph",
      "type": "int[][]"
    }
  ],
  "returns": "boolean",
  "tests": [
    {"input":[[[1,3],[0,2],[1,3],[0,2]]],"expected":true,"sample":true},
    {"input":[[[1,2],[0,2],[0,1]]],"expected":false,"sample":true},
    {"input":[[[]]],"expected":true},
    {"input":[[[],[]]],"expected":true},
    {"input":[[[1],[0]]],"expected":true},
    {"input":[[[1],[0],[]]],"expected":true},
    {"input":[[[1],[0],[3],[2]]],"expected":true},
    {"input":[[[1,2],[0],[0]]],"expected":true},
    {"input":[[[1],[0],[3,4],[2,4],[2,3]]],"expected":false},
    {"input":[[[1,4],[0,2],[1,3],[2,4],[3,0]]],"expected":false}
  ]
}
