{
  "id": "binary-tree-paths",
  "style": "leetcode",
  "function": {
    "python": "binaryTreePaths",
    "java": "binaryTreePaths"
  },
  "params": [
    {
      "name": "root",
      "type": "TreeNode"
    }
  ],
  "returns": "List<string>",
  "compare": "unordered",
  "tests": [
    {"input":[[1,2,3,null,5]],"expected":["1->2->5","1->3"],"sample":true},
    {"input":[[1]],"expected":["1"],"sample":true},
    {"input":[[1,2]],"expected":["1->2"]},
    {"input":[[1,null,2]],"expected":["1->2"]},
    {"input":[[1,2,3]],"expected":["1->3","1->2"]},
    {"input":[[-1,-2,3]],"expected":["-1->3","-1->-2"]},
    {"input":[[0]],"expected":["0"]},
    {"input":[[1,1,1]],"expected":["1->1","1->1"]},
    {"input":[[1,2,null,3]],"expected":["1->2->3"]},
    {"input":[[1,2,3,4,5,6,7]],"expected":["1->3->7","1->3->6","1->2->5","1->2->4"]}
  ]
}
