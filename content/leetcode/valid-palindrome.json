{
  "id": "valid-palindrome",
  "style": "leetcode",
  "function": {
    "python": "isPalindrome",
    "java": "isPalindrome"
  },
  "params": [
    {
      "name": "s",
      "type": "string"
    }
  ],
  "returns": "boolean",
  "tests": [
    {"input":["Never odd or even"],"expected":true,"sample":true},
    {"input":["0P"],"expected":false,"sample":true},
    {"input":[" "],"expected":true},
    {"input":[".,!"],"expected":true},
    {"input":["a"],"expected":true},
    {"input":["Aa"],"expected":true},
    {"input":["ab"],"expected":false},
    {"input":["A man, a plan, a canal: Panama"],"expected":true},
    {"input":["race a car"],"expected":false},
    {"input":["12,21"],"expected":true},
    {"input":[""],"expected":true}
  ]
}
