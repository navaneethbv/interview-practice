  "function": {
    "python": "singleNonDuplicate",
    "java": "singleNonDuplicate"
  },
  "params": [
    {
      "name": "nums",
      "type": "int[]"
    }
  ],
  "returns": "int",
  "tests": [
    {"input":[[1,1,2,3,3,4,4]],"expected":2,"sample":true},
    {"input":[[3,3,7,7,10,11,11]],"expected":10,"sample":true},
    {"input":[[0]],"expected":0},
    {"input":[[1,2,2]],"expected":1},
