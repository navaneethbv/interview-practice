{
  "id": "validate-binary-search-tree",
  "style": "leetcode",
  "function": {
    "python": "isValidBST",
    "java": "isValidBST"
  },
  "params": [
    {
      "name": "root",
      "type": "TreeNode"
    }
  ],
  "returns": "boolean",
  "tests": [
    {"input":[[8,4,12,2,6,10,14]],"expected":true,"sample":true},
    {"input":[[8,4,12,null,null,7,14]],"expected":false,"sample":true},
    {"input":[[1]],"expected":true},
    {"input":[[2,1,3]],"expected":true},
    {"input":[[2,2,3]],"expected":false},
    {"input":[[1,null,1]],"expected":false},
    {"input":[[5,1,4,null,null,3,6]],"expected":false},
    {"input":[[-2147483648,null,2147483647]],"expected":true},
    {"input":[[0,-1,1]],"expected":true},
    {"input":[[3,2,null,1]],"expected":true},
    {"input":[[1,null,2,null,3]],"expected":true}
  ]
}
