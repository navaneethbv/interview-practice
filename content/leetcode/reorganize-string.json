    {"input":["a"],"expected":"a"},
    {"input":["aa"],"expected":""},
    {"input":["ab"],"expected":"ab"},
    {"input":["aabb"],"expected":"abab"},
    {"input":["vvvlo"],"expected":"vlvov"},
    {"input":["aaaaabbbb"],"expected":"ababababa"},
    {"input":["abcabc"],"expected":"abcabc"},
    {"input":["zzzyyyxxx"],"expected":"xyzxyzxyz"}
