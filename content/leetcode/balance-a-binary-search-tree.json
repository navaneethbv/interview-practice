{
  "id": "balance-a-binary-search-tree",
  "style": "leetcode",
  "function": {
    "python": "balanceBST",
    "java": "balanceBST"
  },
  "params": [
    {
      "name": "root",
      "type": "TreeNode"
    }
  ],
  "returns": "TreeNode",
  "compare": {
    "validator": "balancedTree"
  },
  "tests": [
    {"input":[[1,null,2,null,3,null,4]],"expected":[3,2,4,1],"sample":true},
    {"input":[[2,1,3]],"expected":[2,1,3],"sample":true},
    {"input":[[1]],"expected":[1]},
    {"input":[[1,null,2]],"expected":[2,1]},
    {"input":[[3,2,null,1]],"expected":[2,1,3]},
    {"input":[[5,3,7,2,4,6,8]],"expected":[5,3,7,2,4,6,8]},
    {"input":[[1,null,2,null,3,null,4,null,5]],"expected":[3,2,5,1,null,4]},
    {"input":[[5,4,null,3,null,2,null,1]],"expected":[3,2,5,1,null,4]},
    {"input":[[10,5,20,null,7]],"expected":[10,7,20,5]},
    {"input":[[100000,1,null,null,50000]],"expected":[50000,1,100000]}
  ]
}
