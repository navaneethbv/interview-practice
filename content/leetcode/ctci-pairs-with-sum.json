{
  "id": "ctci-pairs-with-sum",
  "style": "leetcode",
  "function": {
    "python": "pairSums",
    "java": "pairSums"
  },
  "params": [
    {
      "name": "nums",
      "type": "int[]"
    },
    {
      "name": "target",
      "type": "int"
    }
  ],
  "returns": "List<List<int>>",
  "compare": "unordered",
  "tests": [
    {"input":[[1,5,3,3,3,7,5],8],"sample":true,"expected":[[1,7],[3,5],[3,5]]},
    {"input":[[4,4,4],8],"sample":true,"expected":[[4,4]]},
    {"input":[[],0],"expected":[]},
    {"input":[[1],2],"expected":[]},
    {"input":[[1,1],2],"expected":[[1,1]]},
    {"input":[[-1,1,0,0,2,-2],0],"expected":[[-2,2],[-1,1],[0,0]]},
    {"input":[[5,5,5,5],10],"expected":[[5,5],[5,5]]},
    {"input":[[1,2,3],7],"expected":[]},
    {"input":[[1000000000,-1000000000,0],0],"expected":[[-1000000000,1000000000]]},
    {"input":[[2,6,2,6,2],8],"expected":[[2,6],[2,6]]}
  ]
}
