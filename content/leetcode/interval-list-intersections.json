{
  "id": "interval-list-intersections",
  "style": "leetcode",
  "function": {
    "python": "intervalIntersection",
    "java": "intervalIntersection"
  },
  "params": [
    {
      "name": "firstList",
      "type": "int[][]"
    },
    {
      "name": "secondList",
      "type": "int[][]"
    }
  ],
  "returns": "int[][]",
  "tests": [
    {"input":[[[1,3],[5,7]],[[2,6]]],"expected":[[2,3],[5,6]],"sample":true},
    {"input":[[[1,2]],[[2,3]]],"expected":[[2,2]],"sample":true},
    {"input":[[],[]],"expected":[]},
    {"input":[[],[[1,2]]],"expected":[]},
    {"input":[[[1,2]],[]],"expected":[]},
    {"input":[[[1,2]],[[3,4]]],"expected":[]},
    {"input":[[[1,5]],[[2,3]]],"expected":[[2,3]]},
    {"input":[[[0,0]],[[0,0]]],"expected":[[0,0]]},
    {"input":[[[0,2],[5,10],[13,23],[24,25]],[[1,5],[8,12],[15,24],[25,26]]],"expected":[[1,2],[5,5],[8,10],[15,23],[24,24],[25,25]]},
    {"input":[[[0,1000000000]],[[1,2],[3,4]]],"expected":[[1,2],[3,4]]}
  ]
}
