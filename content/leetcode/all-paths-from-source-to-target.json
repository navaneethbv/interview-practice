{
  "id": "all-paths-from-source-to-target",
  "style": "leetcode",
  "function": {
    "python": "allPathsSourceTarget",
    "java": "allPathsSourceTarget"
  },
  "params": [
    {
      "name": "graph",
      "type": "int[][]"
    }
  ],
  "returns": "List<List<int>>",
  "compare": "unordered",
  "tests": [
    {"input":[[[1,2],[3],[3],[]]],"expected":[[0,1,3],[0,2,3]],"sample":true},
    {"input":[[[1],[]]],"expected":[[0,1]],"sample":true},
    {"input":[[[],[]]],"expected":[]},
    {"input":[[[1],[2],[]]],"expected":[[0,1,2]]},
    {"input":[[[2],[],[]]],"expected":[[0,2]]},
    {"input":[[[1,2],[2],[]]],"expected":[[0,1,2],[0,2]]},
    {"input":[[[1],[],[]]],"expected":[]},
    {"input":[[[1,2,3],[3],[3],[]]],"expected":[[0,1,3],[0,2,3],[0,3]]},
    {"input":[[[1,2],[3,4],[4],[4],[]]],"expected":[[0,1,3,4],[0,1,4],[0,2,4]]},
    {"input":[[[1],[2],[3],[4],[]]],"expected":[[0,1,2,3,4]]}
  ]
}
