  "function": {
    "python": "searchMatrix",
    "java": "searchMatrix"
  },
  "params": [
    {
      "name": "matrix",
      "type": "int[][]"
    },
    {
      "name": "target",
      "type": "int"
    }
  ],
  "returns": "boolean",
  "tests": [
    {"input":[[[1,3,5],[7,9,11]],9],"expected":true,"sample":true},
    {"input":[[[1,3,5],[7,9,11]],6],"expected":false,"sample":true},
    {"input":[[[1]],1],"expected":true},
    {"input":[[[1]],2],"expected":false},
    {"input":[[[1,2,3]],1],"expected":true},
    {"input":[[[1],[3],[5]],5],"expected":true},
    {"input":[[[-5,-3],[-1,0]],-3],"expected":true},
    {"input":[[[1,1],[2,2]],2],"expected":true},
    {"input":[[[1,3],[5,7]],0],"expected":false},
    {"input":[[[1,3],[5,7]],8],"expected":false},
    {"input":[[[1,3],[5,7]],4],"expected":false}
