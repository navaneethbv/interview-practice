    "python": "splitListToParts",
    "java": "splitListToParts"
  },
  "params": [
    {
      "name": "head",
      "type": "ListNode"
    },
    {
      "name": "k",
      "type": "int"
    }
  ],
  "returns": "ListNode[]",
  "tests": [
    {"input":[[1,2,3],5],"expected":[[1],[2],[3],null,null],"sample":true},
    {"input":[[1,2,3,4,5],3],"expected":[[1,2],[3,4],[5]],"sample":true},
    {"input":[[],1],"expected":[null]},
    {"input":[[],3],"expected":[null,null,null]},
