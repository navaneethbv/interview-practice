{
  "id": "copy-list-with-random-pointer",
  "style": "leetcode",
  "function": {
    "python": "copyRandomList",
    "java": "copyRandomList"
  },
  "params": [
    {
      "name": "head",
      "type": "RandomNode"
    }
  ],
  "returns": "RandomNode",
  "tests": [
    {"input":[[[5,1],[7,0]]],"expected":[[5,1],[7,0]],"sample":true},
    {"input":[[]],"expected":[],"sample":true},
    {"input":[[[1,null]]],"expected":[[1,null]]},
    {"input":[[[1,0]]],"expected":[[1,0]]},
    {"input":[[[2,null],[2,null]]],"expected":[[2,null],[2,null]]},
    {"input":[[[1,1],[2,1]]],"expected":[[1,1],[2,1]]},
    {"input":[[[1,null],[2,0],[3,1]]],"expected":[[1,null],[2,0],[3,1]]},
    {"input":[[[4,2],[5,null],[6,0]]],"expected":[[4,2],[5,null],[6,0]]},
    {"input":[[[0,0],[0,0],[0,0]]],"expected":[[0,0],[0,0],[0,0]]},
    {"input":[[[-10000,1],[10000,null]]],"expected":[[-10000,1],[10000,null]]},
    {"input":[[[0,9],[1,8],[2,7],[3,6],[4,5],[5,4],[6,3],[7,2],[8,1],[9,0]]],"expected":[[0,9],[1,8],[2,7],[3,6],[4,5],[5,4],[6,3],[7,2],[8,1],[9,0]]}
  ]
}
