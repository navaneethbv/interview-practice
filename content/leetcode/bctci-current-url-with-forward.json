{
  "id": "bctci-current-url-with-forward",
  "style": "leetcode",
  "function": {
    "python": "currentUrlWithForward",
    "java": "currentUrlWithForward"
  },
  "params": [
    {
      "name": "actions",
      "type": "List<List<string>>"
    }
  ],
  "returns": "string",
  "tests": [
    {"input":[[["go","google.com"],["go","wikipedia.com"],["back","1"],["forward","1"],["back","3"],["go","netflix.com"],["forward","3"]]],"sample":true,"expected":"netflix.com"},
    {"input":[[["go","a.com"],["go","b.com"],["back","1"]]],"sample":true,"expected":"a.com"},
    {"input":[[["go","a.com"],["go","b.com"],["go","c.com"],["back","2"],["forward","1"]]],"expected":"b.com"},
    {"input":[[["go","a.com"],["forward","5"]]],"expected":"a.com"},
    {"input":[[["go","a.com"],["go","b.com"],["back","1"],["go","c.com"],["forward","1"],["back","1"]]],"expected":"a.com"},
    {"input":[[["go","a.com"],["go","b.com"],["back","1000000000"],["forward","1000000000"]]],"expected":"b.com"}
  ]
}
