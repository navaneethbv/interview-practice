{
  "id": "transpose-matrix",
  "style": "leetcode",
  "function": {
    "python": "transpose",
    "java": "transpose"
  },
  "params": [
    {
      "name": "matrix",
      "type": "int[][]"
    }
  ],
  "returns": "int[][]",
  "tests": [
    {"input":[[[1,2,3],[4,5,6]]],"expected":[[1,4],[2,5],[3,6]],"sample":true},
    {"input":[[[7]]],"expected":[[7]],"sample":true},
    {"input":[[[1,2]]],"expected":[[1],[2]]},
    {"input":[[[1],[2]]],"expected":[[1,2]]},
    {"input":[[[1,2],[3,4]]],"expected":[[1,3],[2,4]]},
    {"input":[[[0,0],[0,0]]],"expected":[[0,0],[0,0]]},
    {"input":[[[-1,2],[3,-4]]],"expected":[[-1,3],[2,-4]]},
    {"input":[[[1,2,3]]],"expected":[[1],[2],[3]]},
    {"input":[[[1],[2],[3]]],"expected":[[1,2,3]]},
    {"input":[[[2147483647,-2147483648]]],"expected":[[2147483647],[-2147483648]]}
  ]
}
