{
  "id": "minimum-absolute-difference",
  "style": "leetcode",
  "function": {
    "python": "minimumAbsDifference",
    "java": "minimumAbsDifference"
  },
  "params": [
    {
      "name": "arr",
      "type": "int[]"
    }
  ],
  "returns": "List<List<int>>",
  "tests": [
    {"input":[[4,2,1,3]],"sample":true,"expected":[[1,2],[2,3],[3,4]]},
    {"input":[[3,8,-10,23,19,-4,-14,27]],"sample":true,"expected":[[-14,-10],[19,23],[23,27]]},
    {"input":[[-13,11,-28,5,3]],"expected":[[3,5]]},
    {"input":[[-23,-27,-30,0,9,19,-26,6,22]],"expected":[[-27,-26]]},
    {"input":[[-10,24,6]],"expected":[[-10,6]]},
    {"input":[[-28,10,19,-14]],"expected":[[10,19]]},
    {"input":[[7,-10,25,-16,13]],"expected":[[-16,-10],[7,13]]},
    {"input":[[-26,27]],"expected":[[-26,27]]},
    {"input":[[-29,-16,20,19,26,-22,7,-11,-17,-18]],"expected":[[-18,-17],[-17,-16],[19,20]]},
    {"input":[[28,-6,5,24,21,-17]],"expected":[[21,24]]},
    {"input":[[-10,-9,-14,3,28,-24,-23,-15]],"expected":[[-24,-23],[-15,-14],[-10,-9]]},
    {"input":[[8,-29,27]],"expected":[[8,27]]}
  ]
}
