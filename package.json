{
  "name": "interview-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ingest:grokking": "tsx scripts/ingest/grokking.ts",
    "tests:build": "tsx scripts/judge/build-tests.ts",
