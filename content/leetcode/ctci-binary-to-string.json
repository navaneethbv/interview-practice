    {"input":[0.75],"expected":"0.11"},
    {"input":[0.25],"expected":"0.01"},
    {"input":[0.3],"expected":"ERROR"},
    {"input":[0.72],"expected":"ERROR"},
    {"input":[0.0009765625],"expected":"0.0000000001"},
    {"input":[0.99951171875],"expected":"0.11111111111"},
    {"input":[2.3283064365386963e-10],"expected":"0.00000000000000000000000000000001"},
    {"input":[1.1641532182693481e-10],"expected":"ERROR"}
  ]
